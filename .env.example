# ---- Database ----
# PostgreSQL connection string
DATABASE_URL="postgresql://dropship:dropship@localhost:5432/dropship_ops?schema=public"

# ---- Auth (NextAuth) ----
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="change-me-please-32-chars-min-random"
NEXTAUTH_URL="http://localhost:3000"

# ---- Field encryption ----
# 32-byte key, base64 encoded. Used to encrypt supplier account emails at rest.
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY="change-me-32-byte-base64-key-here========"

# ---- Currency / FX ----
# Frankfurter is free and keyless (ECB rates). Override only if self-hosting.
FX_API_BASE="https://api.frankfurter.app"

# ---- Tracking ----
# Cainiao global tracking JSON endpoint (used for AliExpress / supplier shipments)
CAINIAO_API_BASE="https://global.cainiao.com/global/detail.json"
# How often the worker syncs tracking (cron). Default: every 6 hours.
TRACKING_CRON="0 */6 * * *"
# Optional paid aggregator for customer carriers (FedEx/USPS/UPS). Leave blank to use free/best-effort.
# Supported: "none" (best-effort/deep-link only) | "aftership" | "trackingmore"
CUSTOMER_TRACKING_PROVIDER="none"
CUSTOMER_TRACKING_API_KEY=""

# ---- App ----
# Allow public self-registration? ("true"/"false"). Set false after creating your account.
ALLOW_REGISTRATION="true"
